# Rahandaz (راه‌انداز): copy to .env and fill in. Never commit .env.
# Defaults run everything offline: mock Liara + scripted mock LLM.

# ── Modes ──────────────────────────────────────────────────────────
# mock = in-memory Liara (fixtures, simulated builds) | real = api.liara.ir
LIARA_MODE=mock
# true = scripted agent brain (no LLM key needed). false = use LLM_* below.
MOCK_LLM=true
# Plan and show exact API calls, execute nothing that changes state.
# Defaults to true when LIARA_MODE=real, false in mock mode.
DRY_RUN=
# Destructive actions (delete app, stop app, overwrite env vars, «خرابش کن») are
# unreachable unless this is true; each still needs the resource name typed.
ALLOW_DESTRUCTIVE=false
# Budget guard, Toman per month. Plans above it need an explicit override.
MAX_MONTHLY_COST=1000000
# Comma-separated app name patterns the agent may change (reads are unrestricted).
# On a real account use a prefix, e.g. rahandaz-*
ALLOWED_APPS=*
MAX_AGENT_STEPS=40
MAX_HEAL_ATTEMPTS=3
# LLM token budget per run (prompt + completion); the run stops cleanly when exceeded.
MAX_RUN_TOKENS=400000
# Default wall-clock limit per tool call (build/health waits have their own).
TOOL_TIMEOUT_MS=180000

# ── Liara (real mode) ──────────────────────────────────────────────
# Create in console.liara.ir → API. Use a separate test account; short expiry.
LIARA_API_TOKEN=
LIARA_TEAM_ID=
LIARA_REGION=iran
# Spec default. The kickoff brief mentions https://api.iran.liara.ir (UNVERIFIED which is preferred).
LIARA_API_BASE_URL=https://api.liara.ir

# ── Agent model ────────────────────────────────────────────────────
# Two options, both OpenAI-compatible with tool calling; when both are set the second is an automatic
# fallback. LLM_PROVIDER=liara (default) | openai-compatible decides which goes first.
LLM_PROVIDER=liara
# Liara AI (uses Liara credits; the spec allows Liara's services). Base URL format:
# https://ai.liara.ir/api/v1/<workspace-id>   (create a key in console.liara.ir → AI)
LIARA_AI_BASE_URL=
LIARA_AI_KEY=
LIARA_AI_MODEL=google/gemini-3.7-flash
# Any other OpenAI-compatible provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000

# Optional: embeddings for hybrid docs search (same model as the LiaraYar index).
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# ── Optional ───────────────────────────────────────────────────────
# GitHub token for opening fix PRs (not used yet).
GITHUB_TOKEN=
# Chat bot (Bale is Telegram-API compatible; Telegram: https://api.telegram.org)
CHAT_BOT_TOKEN=
CHAT_BOT_API_BASE=https://tapi.bale.ai
# Comma-separated chat ids allowed to use the bot (empty = nobody).
CHAT_ALLOWED_IDS=

# ── Console ────────────────────────────────────────────────────────
# Basic-auth password for the console (any username). REQUIRED on a deployed console:
# in production, without it the console refuses every change unless ALLOW_OPEN_CONSOLE=true.
CONSOLE_PASSWORD=
ALLOW_OPEN_CONSOLE=false
# Public URL of the console (the chat bot links to it for approvals that need secrets).
CONSOLE_PUBLIC_URL=
# Health monitor that starts incident runs on its own (default 4s mock, 15s real).
HEALTH_MONITOR=true
HEALTH_MONITOR_INTERVAL_MS=

# Where audit log, runs and working copies live (relative to repo root).
RAHANDAZ_DATA_DIR=var
# Mock build speed: 1 = demo pace, 0 = instant (tests).
MOCK_LATENCY_SCALE=1
